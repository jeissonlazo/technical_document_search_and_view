{
  "name": "technical-document-search-and-view",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:infra": "docker compose up -d postgres redis elasticsearch",
    "dev:backend": "pnpm --filter @docs/backend start:dev",
    "dev:worker": "pnpm --filter @docs/backend start:worker:dev",
    "dev:frontend": "pnpm --filter @docs/frontend start",
    "build": "pnpm --filter @docs/backend build && pnpm --filter @docs/frontend build",
    "test": "pnpm --filter @docs/backend test",
    "db:generate": "pnpm --filter @docs/backend prisma:generate",
    "db:migrate": "pnpm --filter @docs/backend prisma:migrate",
    "seed": "pnpm --filter @docs/backend seed"
  }
}
