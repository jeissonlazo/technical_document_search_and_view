# Runtime
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:4200

# PostgreSQL / Neon
# DATABASE_URL usa el host -pooler y pgbouncer=true para runtime.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1
# DIRECT_URL usa el host directo (sin -pooler) para migraciones de Prisma.
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require

# Redis / BullMQ (rediss:// para TLS)
REDIS_URL=redis://localhost:6379

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
# Alias de búsqueda; el índice concreto es {alias}-{version}
ELASTICSEARCH_INDEX=documents
ELASTICSEARCH_INDEX_VERSION=v1
# Solo si usas Elastic Cloud u otro cluster con API key.
ELASTICSEARCH_API_KEY=

# Session
SESSION_SECRET=replace-with-openssl-rand-base64-48
SESSION_TTL_SECONDS=604800
AUTH_USER_CACHE_TTL_SECONDS=30

# Cloudflare R2 (S3-compatible)
# Con un R2 API token: usa Access Key ID y Secret Access Key.
# Con un token de API de Cloudflare: R2_ACCESS_KEY_ID = id del token;
# R2_SECRET_ACCESS_KEY = SHA-256 del valor del token. Valida con `pnpm r2:check`.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=technical-documents
R2_ENDPOINT=
R2_REGION=auto
R2_SIGNED_URL_TTL_SECONDS=300

# Upload limits
MAX_FILE_SIZE_MB=25
MAX_BATCH_FILES=20
MAX_BATCH_TOTAL_MB=100
WORKER_CONCURRENCY=2
QUEUE_OPERATION_TIMEOUT_MS=2000

# Outbox / reconciliación
OUTBOX_RECONCILE_INTERVAL_MS=15000
OUTBOX_STUCK_AFTER_MS=120000
OUTBOX_MAX_ATTEMPTS=10

# Procesamiento
MAX_TEXT_CHARS=2000000
PROCESSING_TIMEOUT_MS=60000

# Seed
SEED_USER_EMAIL=demo@example.com
SEED_USER_PASSWORD=ChangeMe123!
